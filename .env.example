# All PUBLIC_ values are visible in the browser. NEVER put secrets here.
# Use the backend origin (for example https://api.example.com); generated auth paths
# already include /api/v1. Blank flight endpoints disable those requests.
PUBLIC_API_BASE_URL=
PUBLIC_API_AIRPORTS_PATH=
PUBLIC_API_SEARCH_PATH=
# Must contain the literal {id} placeholder, e.g. the path agreed with your backend.
PUBLIC_API_OFFER_PATH=
PUBLIC_API_SEARCH_METHOD=GET
# same-origin by default; include only when your API's CORS/cookie policy supports it.
PUBLIC_API_CREDENTIALS=same-origin
PUBLIC_DEFAULT_CURRENCY=USD
# Canonical website origin. This is build configuration, not a secret.
SITE_URL=
