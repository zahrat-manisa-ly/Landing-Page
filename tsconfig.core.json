{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/lib/domain/**/*.ts", "src/lib/api/**/*.ts", "src/env.d.ts", "src/i18n/**/*.ts"],
  "exclude": ["src/lib/api/environment.ts"]
}
