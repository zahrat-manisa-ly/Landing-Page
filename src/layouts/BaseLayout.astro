---
import '../styles/global.css';
// Fonts are installed as dependencies, never distributed as font files in this archive.
import '@fontsource-variable/inter';
import '@fontsource-variable/alexandria';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { t } from '../i18n/index';
import type { Locale } from '../lib/domain/types';
import { publicApiConfig } from '../lib/api/environment';
interface Props {
  title: string;
  description?: string;
  locale: Locale;
  noindex?: boolean;
  pageClass?: string;
}
const {
  title,
  description = 'Find your next journey with MANISA Travel.',
  locale,
  noindex = false,
  pageClass = '',
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang={locale} dir={locale === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | MANISA Travel</title><meta name="description" content={description} />
    <meta name="theme-color" content="#faf6ef" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {
      canonical &&
        (['en', 'ar'] as const).map((lang) => (
          <link
            rel="alternate"
            hreflang={lang}
            href={
              new URL(Astro.url.pathname.replace(/^\/(en|ar)(?=\/|$)/, `/${lang}`), Astro.site).href
            }
          />
        ))
    }
    <meta property="og:title" content={`${title} | MANISA Travel`} /><meta
      property="og:description"
      content={description}
    /><meta property="og:type" content="website" />
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main">{t(locale, 'skip')}</a>
    <Header locale={locale} currency={publicApiConfig.defaultCurrency} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer locale={locale} currency={publicApiConfig.defaultCurrency} />
  </body>
</html>
